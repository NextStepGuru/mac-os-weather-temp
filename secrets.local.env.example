# Copy to secrets.local.env and fill in (never commit secrets.local.env).
# Then run: ./scripts/setup_github_secrets.sh

# Path to your exported Developer ID Application .p12 file
P12_PATH="$HOME/path/to/DeveloperID.p12"
P12_PASSWORD="your-p12-export-password"

APPLE_ID="you@example.com"
APPLE_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"
APPLE_TEAM_ID="XXXXXXXXXX"

# Any random string for the temporary CI keychain
KEYCHAIN_PASSWORD="generate-a-long-random-string"

# Must match the name shown in Keychain Access exactly, e.g.:
# Developer ID Application: Your Name (TEAMID)
CODESIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
